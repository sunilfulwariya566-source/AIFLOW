# Copy this file to .env and edit. Sab optional hai —
# bina kisi key ke bhi AIFlow offline mock model pe poora chalta hai.

# ---- Server ----
# PORT=8000

# ---- Security ----
# Production me ye teen ZAROOR set karo:
#   AIFLOW_ADMIN_KEY      — warna seeded admin key public default hai
#   AIFLOW_WEBHOOK_SECRET — warna koi bhi webhook forge kar sakta hai
#   AIFLOW_RATE_LIMIT     — apne traffic ke hisaab se
# AIFLOW_ADMIN_KEY=<koi lamba random string>
# Local pe auth band karna ho to 0 kar do (UI ko key ki zaroorat nahi padegi)
AIFLOW_AUTH=1
# Webhook signing secret — production me zaroor badlo
AIFLOW_WEBHOOK_SECRET=dev-webhook-secret
# Per key+IP request limit
AIFLOW_RATE_LIMIT=120

# ---- Real LLM providers (optional) ----
# OpenAI ya koi bhi OpenAI-compatible endpoint
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local model via Ollama (pehle `ollama serve` chalao)
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.0-flash

# ---- Web search for the agent's `search` tool (optional) ----
# Pehla jo mile wahi use hoga; kuch na ho to offline stub chalega.
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
# BRAVE_API_KEY=...
# AIFLOW_SEARCH_DDG=1        # keyless DuckDuckGo endpoint
# AIFLOW_SEARCH_TIMEOUT=10
# AIFLOW_SEARCH=mock          # force the offline stub even if keys are set

# ---- Streaming ----
# Mock provider ka artificial token delay (0 = turant)
# AIFLOW_MOCK_STREAM_DELAY=0.012
